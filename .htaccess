# Pas de cache sur les pages : le visiteur doit toujours recevoir la version du
# serveur. Sans consigne, free.fr n'envoie que Last-Modified et ETag, et le
# navigateur applique une fraîcheur heuristique — il peut resservir une page
# vieille de plusieurs jours sans rien demander. C'est ce qui s'est produit le
# 25 août 2026 : un sommaire périmé s'affichait alors que le serveur servait
# bien le nouveau.
#
# Relevé sur free.fr le 26 août 2026 : mod_expires est actif, mod_headers ne
# l'est pas. C'est donc le second bloc qui agit ; le premier est conservé, sans
# effet aujourd'hui, au cas où l'hébergeur l'activerait.
#
# Les blocs IfModule sont indispensables : une directive laissée nue renverrait
# une erreur 500 sur tout le site si son module manquait.
#
# Effet obtenu : Cache-Control max-age=0, donc revalidation à chaque visite. La
# page n'est pas retéléchargée pour autant — le serveur répond 304 tant qu'elle
# n'a pas changé. Les images et les PDF gardent leur cache : ils ne changent
# pas, et pèsent 1,6 Mo à eux seuls.
#
# Ce fichier ne sert qu'à free.fr ; GitHub Pages ne le lit pas et n'offre aucun
# réglage d'en-têtes.

<IfModule mod_headers.c>
  <FilesMatch "[.](html?|css|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>

# Les anciennes pages d'un exercice converti renvoient vers la nouvelle, qui
# réunit l'énoncé et le corrigé. Un visiteur venu d'un signet ou d'un moteur de
# recherche ne doit plus lire la version périmée.
#
# On redirige le dossier entier de l'exercice, et non des fichiers nommés un à
# un : outre _enon et _cons, les corrigés hérités ne sont pas liés par href mais
# par des survols FrontPage, et leurs noms ne sont pas devinables. Les images du
# dossier suivent, ce qui est sans effet : plus aucune page ne les demande.
#
# e_1_1 ne capture pas e_1_10 à e_1_14 : le motif exige une barre ou la fin.
#
# 301 : les navigateurs la retiennent durablement. À n'écrire que pour un
# exercice réellement converti.

<IfModule mod_alias.c>
  RedirectMatch 301 ^/electricite/e_1/e_1_1(/.*)?$ /exercices/electricite/e1/e1_1.html
  RedirectMatch 301 ^/electricite/e_1/e_1_2(/.*)?$ /exercices/electricite/e1/e1_2.html
  RedirectMatch 301 ^/electricite/e_1/e_1_3(/.*)?$ /exercices/electricite/e1/e1_3.html
  RedirectMatch 301 ^/electricite/e_1/e_1_4(/.*)?$ /exercices/electricite/e1/e1_4.html
</IfModule>
